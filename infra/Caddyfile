# Caddyfile — FJcloud.app
# Bloque añadido al Caddyfile de Contabo (13.140.186.234) SIN tocar el bloque
# existente de JTAS (13-140-186-234.nip.io → /opt/jtas).
# URL: https://fjcloud.13-140-186-234.nip.io/  (nip.io resuelve a la IP)
#
# Deploy en el VPS:
#   cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak.fjcloud
#   cat bloque >> /etc/caddy/Caddyfile
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Cuando haya dominio propio, reemplazar el host por:
#   fjcloud.app, www.fjcloud.app
# (Caddy emitirá certificado TLS automáticamente y redirigirá HTTP→HTTPS)

fjcloud.13-140-186-234.nip.io {
	root * /opt/fjcloud
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; connect-src 'self'; manifest-src 'self'"
	}

	# NUNCA max-age puro en HTML/sw (usuarios con archivos viejos hasta 24 h)
	@html path *.html / 
	header @html Cache-Control "no-cache"
	@sw path /sw.js
	header @sw Cache-Control "no-cache"
	@manifest path /manifest.json
	header @manifest Cache-Control "no-cache"

	# Státicos: 60 s + revalidate en background
	@assets path /js/* /fonts/* /icons/*
	header @assets Cache-Control "max-age=60, stale-while-revalidate=86400"

	file_server
}
